  METHOD if_badi_cte_fin_post_dt_change~map_entry_additional_data.
*   Mapping of additional customer data
*   from CTE Input structure to CTE working structures

*   Local data
    DATA: lr_struc TYPE REF TO cl_abap_structdescr.
    DATA: lt_comp TYPE cl_abap_structdescr=>component_table.
    DATA: ls_comp LIKE LINE OF lt_comp.
    DATA: ls_entry_additional_data TYPE cte_s_additional_data.
    FIELD-SYMBOLS <lfs_field> TYPE any.

*   Get IS_ENTRY_DATA structure fields and data
    lr_struc ?= cl_abap_structdescr=>describe_by_data( is_entry_data ). "Get the description of is_entry_data
    lt_comp = lr_struc->get_components( ). "Get the fields of is_entry_data

*   Fill custom fields if not initial and append to export table
*    LOOP AT lt_comp INTO ls_comp.
*      IF ls_comp-name CS 'CUSTOM'.
*        ls_entry_additional_data-name = ls_comp-name.
*        ASSIGN COMPONENT ls_comp-name OF STRUCTURE is_entry_data TO <lfs_field>.
*        ls_entry_additional_data-value = <lfs_field>.
*        APPEND ls_entry_additional_data TO et_entry_additional_data.
*        CLEAR ls_entry_additional_data.
*      ENDIF.
*    ENDLOOP.
*    LOOP AT lt_comp INTO ls_comp.
*      IF ls_comp-name CS 'ORG_UNIT'.
*        ls_entry_additional_data-name = ls_comp-name.
*        ASSIGN COMPONENT ls_comp-name OF STRUCTURE is_entry_data TO <lfs_field>.
*        ls_entry_additional_data-value = <lfs_field>.
*        APPEND ls_entry_additional_data TO et_entry_additional_data.
*        CLEAR ls_entry_additional_data.
*      ENDIF.
*    ENDLOOP.
    LOOP AT lt_comp INTO ls_comp.
      IF ls_comp-name CS 'CUSTOM' OR
         ls_comp-name CS 'ORG' OR
         ls_comp-name CS 'VENDOR' OR
         ls_comp-name CS 'CODE' OR
         ls_comp-name CS 'ENTRY' OR
         ls_comp-name CS 'ID'.
        ls_entry_additional_data-name = ls_comp-name.
        ASSIGN COMPONENT ls_comp-name OF STRUCTURE is_entry_data TO <lfs_field>.
        ls_entry_additional_data-value = <lfs_field>.
        APPEND ls_entry_additional_data TO et_entry_additional_data.
        CLEAR ls_entry_additional_data.
      ENDIF.
    ENDLOOP.


*   Excluding PaidByCompany receipts from posting
    " determine the report entry payment type key of the expense and
    " make the payment type key available for being used in the other BAdIs
    ls_entry_additional_data-name = 'REPORT_ENTRY_PAT_KEY'.
    ls_entry_additional_data-value = is_entry_data-report_entry_pat_key.
    INSERT ls_entry_additional_data INTO TABLE et_entry_additional_data.

  ENDMETHOD.
